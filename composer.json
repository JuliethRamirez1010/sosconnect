{
  "name":"hospital/boton-panico",
  "type":"project",
  "description":"Sistema hospitalario - Etapa 1",
  "require":{"php":"^8.3","laravel/framework":"^13.0","laravel/breeze":"^2.4"},
  "require-dev":{"pestphp/pest":"^4.0","pestphp/pest-plugin-laravel":"^4.0","fakerphp/faker":"^1.24","mockery/mockery":"^1.6","nunomaduro/collision":"^8.8"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{"setup":["@php -r \"file_exists('.env') || copy('.env.example', '.env');\"","@php artisan key:generate","@php artisan migrate --seed","npm install","npm run build"],"test":"@php artisan test"},
  "config":{"allow-plugins":{"pestphp/pest-plugin":true}},
  "minimum-stability":"stable","prefer-stable":true
}
